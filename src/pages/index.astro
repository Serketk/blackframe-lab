---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CTASection from '../components/CTASection.astro';
import ArtDirection from '../components/ArtDirection.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { featuredProjects } from '../data/projects';
import { services, lifecycleStages, differentiators, experienceCapabilities } from '../data/services';
import type { ArtVariant } from '../components/ArtDirection.astro';
import { faqItems } from '../data/faq';
import { getCollection } from 'astro:content';
import { siteMeta } from '../data/nav';

const visualStrip: { variant: ArtVariant; label: string }[] = [
  { variant: 'architecture', label: 'Structure' },
  { variant: 'wellness', label: 'Experience' },
  { variant: 'professional', label: 'Clarity' },
  { variant: 'signature', label: 'Identity' },
];

const allArticles = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestArticles = allArticles.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      name: siteMeta.name,
      description: siteMeta.description,
      url: siteMeta.url,
      email: siteMeta.email,
      areaServed: 'Worldwide',
    },
    {
      '@type': 'WebSite',
      name: siteMeta.name,
      url: siteMeta.url,
    },
  ],
};
---

<BaseLayout title={siteMeta.name} description={siteMeta.description} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <SectionLabel label="Independent Web Design Studio" />
        <h1 class="hero__title">
          BLACKFRAME <span class="hero__title-accent">LAB</span>
          <span class="hero__title-line">Websites designed beyond launch.</span>
        </h1>
        <p class="hero__supporting">
          We design, build and evolve websites for brands that need a stronger digital presence.
        </p>
        <div class="hero__actions">
          <a href="/work" class="btn btn-primary">
            View Work <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="/start-a-project" class="btn btn-secondary">Start a Project</a>
        </div>
      </div>
      <div class="hero__visual">
        <ArtDirection variant="signature" ratio="4 / 5" />
      </div>
    </div>
    <div class="hero__model">
      <span>Strategy</span>
      <span>Design</span>
      <span>Build</span>
      <span>Launch</span>
      <span>Grow</span>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="section-border-top who">
    <div class="container who__grid">
      <SectionLabel label="Who We Are" />
      <h2 class="who__heading">
        We build <span class="who__heading-fade"
          >structured, production-ready websites for brands that need a stronger digital
          presence.</span
        >
      </h2>
      <a href="/studio" class="who__link">About the Studio</a>
    </div>
  </section>

  <!-- VISUAL STRIP -->
  <section class="section-border-top visual-strip">
    <div class="visual-strip__grid">
      {
        visualStrip.map((item) => (
          <div class="visual-strip__item">
            <ArtDirection variant={item.variant} ratio="3 / 4" />
            <span class="visual-strip__label">{item.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- BY THE NUMBERS -->
  <section class="section-border-top stat-band">
    <div class="container stat-band__row">
      <p class="stat-band__item">
        <span class="stat-band__number">5+</span> years of hands-on experience
      </p>
      <p class="stat-band__item">
        <span class="stat-band__number">4</span> core service offers
      </p>
      <p class="stat-band__item">
        <span class="stat-band__number">5</span> stages, strategy through grow
      </p>
      <p class="stat-band__item">
        <span class="stat-band__number">1</span> point of direct contact
      </p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section-border-top offer">
    <div class="container">
      <SectionLabel label="Services" />
      <h2 class="offer__heading">Four ways to work with the studio.</h2>

      <div class="offer__list">
        {
          services.map((service) => (
            <a href={`/services#${service.slug}`} class="offer__item">
              <span class="offer__index">{service.index}</span>
              <span class="offer__name">{service.name}</span>
              <span class="offer__summary text-secondary">{service.summary}</span>
            </a>
          ))
        }
      </div>

      <a href="/pricing" class="offer__pricing-link">See starting prices by project type</a>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section section-border-top">
    <div class="container">
      <div class="section-heading">
        <SectionLabel label="Selected Work" />
        <a href="/work" class="section-heading__link">View all work</a>
      </div>

      <div class="work-grid">
        {
          featuredProjects.map((project, i) => (
            <ProjectCard project={project} index={`0${i + 1}`} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FULL-SCOPE WEB CAPABILITY -->
  <section class="section section-border-top lifecycle">
    <div class="container">
      <SectionLabel label="Full-Scope Web Capability" />
      <h2 class="lifecycle__heading">One partner from first structure to post-launch evolution.</h2>

      <ol class="lifecycle__list">
        {
          lifecycleStages.map((stage) => (
            <li class="lifecycle__item">
              <span class="lifecycle__index">{stage.index}</span>
              <h3 class="lifecycle__name">{stage.name}</h3>
              <p class="text-secondary">{stage.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- WHY BLACKFRAME -->
  <section class="section section-border-top why">
    <div class="container">
      <SectionLabel label="Why Blackframe" />
      <h2 class="why__heading">Tangible reasons, not agency claims.</h2>

      <div class="why__bento">
        {
          differentiators.map((item, i) => (
            <div class:list={['why__card', { 'why__card--wide': i === 0 }]}>
              <span class="why__card-number" aria-hidden="true">{`0${i + 1}`}</span>
              <h3>{item.name}</h3>
              <p class="text-secondary">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="section section-border-top experience">
    <div class="container">
      <SectionLabel label="Experience" />
      <h2 class="experience__heading">
        5+ years of hands-on experience across web, UX/UI and digital production.
      </h2>
      <ul class="experience__tags">
        {experienceCapabilities.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- INSIGHTS -->
  {
    latestArticles.length > 0 && (
      <section class="section section-border-top">
        <div class="container">
          <div class="section-heading">
            <SectionLabel label="Insights" />
            <a href="/insights" class="section-heading__link">All insights</a>
          </div>
          <div class="insights-list">
            {latestArticles.map((article) => <ArticleCard article={article} />)}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="section section-border-top faq-section">
    <div class="container faq-section__grid">
      <div>
        <SectionLabel label="Questions" />
        <h2 class="faq-section__heading">Answers, before you ask.</h2>
      </div>
      <FaqAccordion items={faqItems} />
    </div>
  </section>

  <!-- FINAL CTA -->
  <CTASection
    heading="Have a website to build, redesign or fix?"
    supporting="Tell us where the project stands today, and we'll take it from there."
  />
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__content :global(.section-label) {
    margin-bottom: 1.75rem;
  }

  .hero__visual {
    max-width: 22rem;
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    max-width: 20ch;
  }

  .hero__title-accent {
    color: var(--color-accent);
  }

  .hero__title-line {
    display: block;
    font-size: 0.4em;
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-top: 0.5em;
    letter-spacing: var(--tracking-tight);
  }

  .hero__supporting {
    margin-top: 2rem;
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    max-width: 42ch;
  }

  .hero__actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__model {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero__model span {
    padding: 1rem var(--container-pad);
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__model span:last-child {
    border-right: none;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1.3fr 1fr;
    }

    .hero__visual {
      max-width: none;
      width: 100%;
    }
  }

  @media (min-width: 640px) {
    .hero__model {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .hero__model span:nth-child(4) {
      border-right: 1px solid var(--color-border);
    }
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .section-heading__link {
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    white-space: nowrap;
    text-underline-offset: 4px;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .section-heading__link:hover {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  .who {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .who__grid {
    max-width: 52rem;
  }

  .who__heading {
    margin-top: 1.5rem;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
  }

  .who__heading-fade {
    color: var(--color-text-secondary);
  }

  .who__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.75rem;
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .who__link:hover {
    color: var(--color-accent);
  }

  .visual-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
  }

  .visual-strip__item {
    position: relative;
    background: var(--color-bg);
  }

  .visual-strip__item :global(.art-direction) {
    border: none;
  }

  .visual-strip__label {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .visual-strip__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat-band {
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
  }

  .stat-band__row {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.75rem;
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }

  .stat-band__item {
    color: var(--color-text-secondary);
    font-size: var(--fs-small);
  }

  .stat-band__number {
    font-family: inherit;
    color: var(--color-text);
    font-weight: 600;
  }

  .work-grid {
    display: grid;
    gap: 2.5rem 2rem;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .offer__heading {
    font-size: var(--fs-h2);
    max-width: 20ch;
    margin-top: 1.5rem;
  }

  .offer__list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
  }

  .offer__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-block: 2rem;
    padding-inline: 0.25rem;
    border-top: 1px solid var(--color-border);
    transition: padding-left var(--duration-base) var(--ease-standard);
  }

  .offer__item:hover {
    padding-left: 0.75rem;
  }

  .offer__item:hover .offer__name {
    color: var(--color-accent);
  }

  .offer__index {
    font-size: var(--fs-small);
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .offer__name {
    font-size: var(--fs-h3);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .offer__summary {
    max-width: 42ch;
  }

  @media (min-width: 768px) {
    .offer__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 3rem;
    }
  }

  .offer__pricing-link {
    display: inline-block;
    margin-top: 2.5rem;
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .offer__pricing-link:hover {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  .lifecycle__heading {
    font-size: var(--fs-h2);
    max-width: 26ch;
    margin-top: 1.5rem;
  }

  .lifecycle__list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 2.5rem;
    counter-reset: lifecycle;
  }

  .lifecycle__item {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .lifecycle__index {
    display: block;
    font-size: var(--fs-small);
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .lifecycle__name {
    font-size: var(--fs-h4);
    margin-bottom: 0.6rem;
  }

  @media (min-width: 1024px) {
    .lifecycle__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .why__heading {
    font-size: var(--fs-h2);
    max-width: 22ch;
    margin-top: 1.5rem;
  }

  .why__bento {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1.25rem;
  }

  .why__card {
    position: relative;
    padding: 2rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .why__card-number {
    position: absolute;
    top: -0.5rem;
    right: 1rem;
    font-size: clamp(4rem, 8vw, 6rem);
    font-weight: 600;
    color: var(--color-border);
    line-height: 1;
    pointer-events: none;
  }

  .why__card h3 {
    position: relative;
    font-size: var(--fs-h4);
    margin-bottom: 0.6rem;
    max-width: 22ch;
  }

  .why__card p {
    position: relative;
    max-width: 42ch;
  }

  @media (min-width: 768px) {
    .why__bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why__card--wide {
      grid-column: span 2;
    }

    .why__card--wide p {
      max-width: 56ch;
    }
  }

  .experience__heading {
    font-size: var(--fs-h2);
    max-width: 36ch;
    margin-top: 1.5rem;
  }

  .experience__tags {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .experience__tags li {
    font-size: var(--fs-small);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .insights-list {
    display: flex;
    flex-direction: column;
  }

  .faq-section__grid {
    display: grid;
    gap: 2.5rem;
  }

  .faq-section__heading {
    margin-top: 1.5rem;
    font-size: var(--fs-h2);
    max-width: 16ch;
  }

  @media (min-width: 1024px) {
    .faq-section__grid {
      grid-template-columns: 0.8fr 1.4fr;
    }
  }
</style>
