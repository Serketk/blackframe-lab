---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArtDirection from '../../components/ArtDirection.astro';
import { getCollection } from 'astro:content';

const title = 'Insights';
const description =
  'Notes on websites, structure and what actually determines whether a website works — from BLACKFRAME LAB.';

const articles = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title={title} description={description} path="/insights">
  <section class="insights-hero section">
    <div class="container insights-hero__grid">
      <div>
        <SectionLabel index="01" label="Insights" />
        <h1 class="insights-hero__title">Notes on websites, structure, and what actually works.</h1>
      </div>
      <div class="insights-hero__visual">
        <ArtDirection variant="wellness" ratio="4 / 5" />
      </div>
    </div>
  </section>

  <section class="section-border-top">
    <div class="container insights-index__list">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .insights-hero {
    padding-bottom: 0;
  }

  .insights-hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .insights-hero__title {
    font-size: var(--fs-h1);
    max-width: 22ch;
    margin-top: 1.5rem;
  }

  .insights-hero__visual {
    display: none;
  }

  @media (min-width: 1024px) {
    .insights-hero__grid {
      grid-template-columns: 1.4fr 1fr;
    }

    .insights-hero__visual {
      display: block;
    }
  }

  .insights-index__list {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 5rem);
  }
</style>
