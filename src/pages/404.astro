---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found';
const description = 'The page you are looking for could not be found.';
---

<BaseLayout title={title} description={description} path="/404" noindex={true}>
  <section class="not-found section">
    <div class="container">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title" data-reveal>This page doesn't exist.</h1>
      <p class="not-found__note text-secondary" data-reveal>
        The page you're looking for may have moved or no longer exists.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/work" class="btn btn-secondary">View Work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .not-found__code {
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
  }

  .not-found__title {
    font-size: var(--fs-h1);
    margin-top: 1rem;
    max-width: 18ch;
  }

  .not-found__note {
    margin-top: 1.25rem;
    font-size: var(--fs-body-lg);
    max-width: 40ch;
  }

  .not-found__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
