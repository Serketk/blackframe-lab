---
import ArtDirection from './ArtDirection.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: string;
}

const { project, index } = Astro.props;
---

<a href={`/work/${project.slug}`} class="project-card" data-reveal>
  <div class="project-card__media">
    <ArtDirection variant={project.artVariant} ratio="4 / 3" />
    {index && <span class="project-card__index">{index}</span>}
  </div>
  <div class="project-card__body">
    <div class="project-card__heading">
      <h3 class="project-card__title">{project.title}</h3>
      <span class="project-card__year">{project.year}</span>
    </div>
    <p class="project-card__category text-secondary">{project.category}</p>
    <p class="project-card__type">{project.type}</p>
  </div>
</a>

<style>
  .project-card {
    display: block;
    color: inherit;
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
  }

  .project-card__index {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    z-index: 1;
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    background: rgba(11, 11, 10, 0.55);
    backdrop-filter: blur(4px);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border);
  }

  .project-card__media :global(.art-direction) {
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .project-card:hover .project-card__media :global(.art-direction) {
    transform: scale(1.03);
  }

  .project-card__body {
    padding-top: 1.25rem;
  }

  .project-card__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-card__title {
    font-size: var(--fs-h3);
  }

  .project-card__year {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .project-card__category {
    margin-top: 0.4rem;
    font-size: var(--fs-small);
  }

  .project-card__type {
    margin-top: 0.6rem;
    display: inline-flex;
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
