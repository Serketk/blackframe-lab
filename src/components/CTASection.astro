---
interface Props {
  heading: string;
  supporting?: string;
  ctaLabel?: string;
  ctaHref?: string;
  bordered?: boolean;
}

const {
  heading,
  supporting,
  ctaLabel = 'Start a Project',
  ctaHref = '/start-a-project',
  bordered = true,
} = Astro.props;
---

<section class:list={['cta-section', { 'section-border-top': bordered }]}>
  <div class="container">
    <div class="cta-section__panel">
      <h2 class="cta-section__heading">{heading}</h2>
      {supporting && <p class="cta-section__supporting text-secondary">{supporting}</p>}
      <a href={ctaHref} class="btn btn-primary cta-section__btn">
        {ctaLabel}
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .cta-section__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem);
    border-radius: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .cta-section__heading {
    font-size: var(--fs-h1);
    max-width: 18ch;
  }

  .cta-section__supporting {
    max-width: 48ch;
    font-size: var(--fs-body-lg);
  }

  .cta-section__btn {
    margin-top: 0.5rem;
  }
</style>
