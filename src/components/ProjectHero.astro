---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="project-hero">
  <div class="container">
    <p class="eyebrow project-hero__eyebrow">Case Study — {project.category}</p>
    <h1 class="project-hero__title">{project.title}</h1>
    <p class="project-hero__summary text-secondary">{project.summary}</p>

    <div class="project-hero__disclosure" role="note">
      <strong>{project.type}.</strong> {project.disclosure}
    </div>
  </div>

  <div class="project-hero__media">
    <ImagePlaceholder ratio="16 / 9" label={`${project.title} — hero image`} />
  </div>
</section>

<style>
  .project-hero {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .project-hero__eyebrow {
    margin-bottom: 1.5rem;
  }

  .project-hero__title {
    font-size: var(--fs-display);
    max-width: 16ch;
  }

  .project-hero__summary {
    margin-top: 1.5rem;
    font-size: var(--fs-body-lg);
    max-width: 56ch;
  }

  .project-hero__disclosure {
    margin-top: 2rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--color-accent-soft);
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  .project-hero__disclosure strong {
    color: var(--color-text);
  }

  .project-hero__media {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
</style>
