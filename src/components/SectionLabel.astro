---
interface Props {
  index?: string;
  label: string;
  align?: 'left' | 'center';
}

const { index, label, align = 'left' } = Astro.props;
---

<div class:list={['section-label', { 'section-label--center': align === 'center' }]}>
  {index && <span class="section-label__index">{index}</span>}
  <span class="section-label__text">{label}</span>
</div>

<style>
  .section-label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .section-label--center {
    justify-content: center;
  }

  .section-label__index {
    color: var(--color-accent);
  }

  .section-label__text::before {
    content: '/ ';
    color: var(--color-accent);
  }
</style>
