---
import { primaryNav, ctaLink, siteMeta } from '../data/nav';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${siteMeta.name} — Home`}>
      <span class="site-header__logo-full">BLACKFRAME</span>
      <span class="site-header__logo-lab">LAB</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {
          primaryNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={ctaLink.href} class="btn btn-primary site-header__cta">{ctaLink.label}</a>
      <button
        type="button"
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <span class="site-header__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 11, 10, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  .site-header__logo {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
  }

  .site-header__logo-lab {
    color: var(--color-accent);
    font-size: 0.75em;
    letter-spacing: var(--tracking-wider);
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul {
    display: flex;
    gap: 2.25rem;
  }

  .site-header__nav a {
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-normal);
    color: var(--color-text-secondary);
    position: relative;
    padding-block: 0.25rem;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-text);
    transition: right var(--duration-base) var(--ease-standard);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    right: 0;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__cta {
    display: none;
  }

  .site-header__menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
  }

  .site-header__menu-icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 16px;
  }

  .site-header__menu-icon span {
    display: block;
    height: 1px;
    background: var(--color-text);
  }

  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .site-header__menu-toggle {
      display: none;
    }
  }
</style>
