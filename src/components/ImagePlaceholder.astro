---
interface Props {
  ratio?: string;
  label?: string;
  index?: string;
  class?: string;
}

const { ratio = '4 / 3', label = 'Replace with project image', index, class: className } = Astro.props;
---

<div class:list={['image-placeholder', className]} style={`aspect-ratio: ${ratio};`}>
  <div class="image-placeholder__grid" aria-hidden="true"></div>
  <span class="image-placeholder__label">
    {index && <span class="image-placeholder__index">{index}</span>}
    {label}
  </span>
</div>

<style>
  .image-placeholder {
    position: relative;
    width: 100%;
    background:
      linear-gradient(160deg, var(--color-surface-raised), var(--color-surface) 70%);
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .image-placeholder__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.35;
  }

  .image-placeholder__label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin: 1.25rem;
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .image-placeholder__index {
    color: var(--color-accent);
  }
</style>
