---
export type ArtVariant = 'architecture' | 'wellness' | 'professional' | 'signature';

interface Props {
  variant: ArtVariant;
  ratio?: string;
  label?: string;
  class?: string;
}

const { variant, ratio = '4 / 3', label, class: className } = Astro.props;
---

<div class:list={['art-direction', `art-direction--${variant}`, className]} style={`aspect-ratio: ${ratio};`}>
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`grad-${variant}`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--art-grad-from)" />
        <stop offset="100%" stop-color="var(--art-grad-to)" />
      </linearGradient>
      <radialGradient id={`glow-${variant}`} cx="50%" cy="35%" r="65%">
        <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.16" />
        <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="400" height="300" fill={`url(#grad-${variant})`} />
    <rect width="400" height="300" fill={`url(#glow-${variant})`} />

    {
      variant === 'architecture' && (
        <g stroke="var(--art-line)" fill="none" stroke-width="1">
          <polygon points="60,220 60,120 180,80 180,180" />
          <polygon points="180,180 180,80 300,50 300,150" opacity="0.7" />
          <line x1="60" y1="220" x2="300" y2="150" />
          <line x1="180" y1="180" x2="340" y2="130" stroke="var(--color-accent)" stroke-width="1.25" />
          <line x1="0" y1="240" x2="400" y2="240" opacity="0.35" />
          <line x1="0" y1="260" x2="400" y2="260" opacity="0.2" />
        </g>
      )
    }

    {
      variant === 'wellness' && (
        <g stroke="var(--art-line)" fill="none" stroke-width="1">
          <circle cx="150" cy="150" r="80" />
          <circle cx="150" cy="150" r="55" opacity="0.55" />
          <circle cx="260" cy="110" r="34" stroke="var(--color-accent)" stroke-width="1.25" opacity="0.8" />
          <line x1="40" y1="260" x2="360" y2="260" opacity="0.25" />
        </g>
      )
    }

    {
      variant === 'signature' && (
        <g stroke="var(--art-line)" fill="none" stroke-width="1">
          <rect x="90" y="60" width="220" height="180" />
          <path d="M90,60 L150,60 M90,60 L90,120" stroke="var(--color-accent)" stroke-width="1.5" />
          <path d="M310,240 L250,240 M310,240 L310,180" stroke="var(--color-accent)" stroke-width="1.5" />
          <line x1="90" y1="150" x2="310" y2="150" opacity="0.4" />
          <line x1="200" y1="60" x2="200" y2="240" opacity="0.4" />
          <circle cx="200" cy="150" r="34" opacity="0.7" />
        </g>
      )
    }

    {
      variant === 'professional' && (
        <g fill="var(--art-line)">
          <rect x="50" y="190" width="18" height="60" opacity="0.5" />
          <rect x="82" y="150" width="18" height="100" opacity="0.65" />
          <rect x="114" y="170" width="18" height="80" opacity="0.5" />
          <rect x="146" y="110" width="18" height="140" fill="var(--color-accent)" opacity="0.9" />
          <rect x="178" y="160" width="18" height="90" opacity="0.55" />
          <rect x="210" y="130" width="18" height="120" opacity="0.6" />
          <rect x="242" y="180" width="18" height="70" opacity="0.45" />
          <line x1="40" y1="252" x2="320" y2="252" stroke="var(--art-line)" stroke-width="1" opacity="0.4" />
        </g>
      )
    }

    <path d="M14,34 L14,14 L34,14" stroke="var(--color-accent)" stroke-width="1.5" fill="none" />
    <path
      d="M366,266 L366,286 L346,286"
      stroke="var(--color-accent)"
      stroke-width="1.5"
      fill="none"
    />
  </svg>

  {label && <span class="art-direction__label">{label}</span>}
</div>

<style>
  .art-direction {
    --art-grad-from: var(--color-surface-raised);
    --art-grad-to: var(--color-surface);
    --art-line: rgba(242, 240, 236, 0.5);
    position: relative;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: flex-end;
  }

  .art-direction svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .art-direction--wellness {
    --art-grad-from: #16140f;
    --art-grad-to: #0e0d0a;
  }

  .art-direction--professional {
    --art-grad-from: #121212;
    --art-grad-to: #0a0a09;
  }

  .art-direction__label {
    position: relative;
    z-index: 1;
    margin: 1.1rem;
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
